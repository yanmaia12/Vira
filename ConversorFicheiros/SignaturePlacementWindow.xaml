<Window x:Class="ConversorFicheiros.SignaturePlacementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Posicionar assinatura" Height="840" Width="980" MinHeight="650" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="#F4F6FB" ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Posicione a assinatura" FontSize="24" FontWeight="Bold" Foreground="#172033" />
            <TextBlock Text="Arraste a assinatura na página. Use o canto azul ou o controlo abaixo para ajustar o tamanho."
                       Foreground="#667085" Margin="0,5,0,12" TextWrapping="Wrap" />
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="SizeText" DockPanel.Dock="Right" Width="64" TextAlignment="Right"
                           VerticalAlignment="Center" Foreground="#475467" />
                <TextBlock Text="Tamanho" DockPanel.Dock="Left" Margin="0,0,12,0"
                           VerticalAlignment="Center" Foreground="#475467" />
                <Slider x:Name="SizeSlider" Minimum="8" Maximum="70" Value="32" TickFrequency="1"
                        IsMoveToPointEnabled="True" ValueChanged="SizeSlider_ValueChanged" />
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="#E8ECF3" CornerRadius="14" Padding="12" BorderBrush="#D7DDE8" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid x:Name="PageCanvas" Background="White" ClipToBounds="True">
                        <Image x:Name="PdfPreviewImage" Stretch="Fill" IsHitTestVisible="False" />
                        <Canvas x:Name="PlacementCanvas" Background="Transparent">
                            <Border x:Name="SignatureBounds" BorderBrush="#315FEA" BorderThickness="1"
                                    Background="#01FFFFFF" Cursor="SizeAll" MouseLeftButtonDown="SignatureBounds_MouseLeftButtonDown"
                                    MouseMove="SignatureBounds_MouseMove" MouseLeftButtonUp="SignatureBounds_MouseLeftButtonUp">
                                <Grid>
                                    <Image x:Name="SignatureImage" Stretch="Fill" IsHitTestVisible="False" />
                                    <primitives:Thumb x:Name="ResizeThumb" Width="16" Height="16" HorizontalAlignment="Right"
                                                      VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta">
                                        <primitives:Thumb.Template>
                                            <ControlTemplate TargetType="primitives:Thumb">
                                                <Border Background="#315FEA" BorderBrush="White" BorderThickness="1" CornerRadius="3" />
                                            </ControlTemplate>
                                        </primitives:Thumb.Template>
                                    </primitives:Thumb>
                                </Grid>
                            </Border>
                        </Canvas>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock Text="A assinatura será aplicada na primeira página. O original não será alterado."
                       Foreground="#667085" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" MinWidth="100" Click="Cancel_Click" />
                <Button Content="Guardar PDF assinado" MinWidth="170" Background="#315FEA" Foreground="White"
                        IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
