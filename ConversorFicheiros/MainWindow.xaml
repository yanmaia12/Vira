<Window x:Class="ConversorFicheiros.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Conversor de Ficheiros" Height="760" Width="1000" MinHeight="650" MinWidth="820" WindowStartupLocation="CenterScreen" Background="#F4F6FB" AllowDrop="True" DragOver="DropTarget_DragOver" Drop="DropTarget_Drop">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Conversor de Ficheiros" FontSize="30" FontWeight="Bold" Foreground="#172033"/><TextBlock Text="Conversão rápida e assinatura PDF, tudo no seu computador." FontSize="15" Foreground="#667085" Margin="0,6,0,22"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="White" CornerRadius="18" Padding="22" BorderBrush="#E2E7F0" BorderThickness="1"><DockPanel>
<StackPanel DockPanel.Dock="Top"><TextBlock Text="Converter ficheiros" FontSize="20" FontWeight="Bold"/><TextBlock Text="Arraste ficheiros para esta área ou escolha-os no computador." Foreground="#667085" Margin="0,5,0,16"/><StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Button Content="Adicionar ficheiros" Background="#315FEA" Foreground="White" Click="AddFiles_Click"/><TextBlock Text="Destino" VerticalAlignment="Center" Margin="16,0,8,0"/><ComboBox x:Name="TargetFormat" Width="100" SelectedIndex="0" Padding="8"><ComboBoxItem Content="png"/><ComboBoxItem Content="jpg"/><ComboBoxItem Content="bmp"/><ComboBoxItem Content="tiff"/><ComboBoxItem Content="pdf"/></ComboBox></StackPanel></StackPanel>
<ListBox x:Name="FileList" Background="#F8F9FC" BorderBrush="#E6EAF1" AllowDrop="True"/><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Limpar lista" Click="Clear_Click"/><Button x:Name="ConvertButton" Content="Converter" Background="#315FEA" Foreground="White" Click="Convert_Click"/></StackPanel>
</DockPanel></Border>
<StackPanel Grid.Column="2"><Border Background="White" CornerRadius="18" Padding="22" BorderBrush="#E2E7F0" BorderThickness="1"><StackPanel><TextBlock Text="Assinar PDF" FontSize="20" FontWeight="Bold"/><TextBlock Text="Desenhe a assinatura no telemóvel e receba-a no PC através de um QR code." TextWrapping="Wrap" Foreground="#667085" Margin="0,8,0,14"/><Button Content="Iniciar assinatura por QR" Background="#14233D" Foreground="White" Click="SignPdf_Click"/></StackPanel></Border>
<Border x:Name="QrPanel" Visibility="Collapsed" Background="White" CornerRadius="18" Padding="18" Margin="0,16,0,0" BorderBrush="#E2E7F0" BorderThickness="1"><StackPanel><TextBlock Text="Leia com o telemóvel" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/><Image x:Name="QrImage" Width="210" Height="210" Margin="0,12"/><TextBlock Text="Os dois dispositivos devem estar na mesma rede Wi-Fi." TextWrapping="Wrap" TextAlignment="Center" Foreground="#667085"/></StackPanel></Border>
<Border Background="#EAF0FF" CornerRadius="18" Padding="18" Margin="0,16,0,0"><StackPanel><TextBlock Text="Menu de contexto" FontWeight="Bold" FontSize="16"/><TextBlock Text="Adicione atalhos de conversão ao botão direito do Explorador do Windows." TextWrapping="Wrap" Foreground="#53617A" Margin="0,6,0,8"/><Button Content="Adicionar ao Explorador" Background="White" Foreground="#244EC8" Click="ContextMenu_Click"/></StackPanel></Border></StackPanel></Grid>
<Border Grid.Row="2" Background="White" CornerRadius="12" Padding="12" Margin="0,16,0,0"><TextBlock x:Name="StatusText" Text="Pronto. Arraste ficheiros para a janela para começar." Foreground="#475467"/></Border></Grid></Window>
